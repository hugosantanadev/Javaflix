{
  "name": "javaflix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma de estudo de Java em formato de streaming: certificação Oracle (1Z0-829/830/831) e stack backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify": "tsc -b && tsx scripts/verify.ts",
    "verify:rapido": "tsx scripts/verify.ts --sem-java",
    "videos:importar": "tsx scripts/videos-importar.ts",
    "links": "tsx scripts/links.ts"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.2.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/schibsted-grotesk": "^5.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@shikijs/engine-javascript": "^3.23.0",
    "@shikijs/langs": "^3.23.0",
    "marked": "^16.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "shiki": "^3.13.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
